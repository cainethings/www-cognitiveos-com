RewriteEngine On

# Preserve Authorization header for PHP.
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Route API requests to the PHP front controller.
RewriteCond %{REQUEST_URI} ^/api(?:/|$) [NC]
RewriteCond %{REQUEST_URI} !^/api/public/ [NC]
RewriteRule ^api(?:/.*)?$ /api/public/index.php [L,QSA]

# Serve built assets from frontend/dist when they exist.
RewriteCond %{REQUEST_URI} !^/api [NC]
RewriteCond %{REQUEST_URI} !^/frontend/dist/ [NC]
RewriteCond %{DOCUMENT_ROOT}/frontend/dist%{REQUEST_URI} -f [OR]
RewriteCond %{DOCUMENT_ROOT}/frontend/dist%{REQUEST_URI} -d
RewriteRule ^(.*)$ /frontend/dist/$1 [L]

# SPA fallback to frontend/dist/index.html.
RewriteCond %{REQUEST_URI} !^/api [NC]
RewriteCond %{REQUEST_URI} !^/frontend/dist/ [NC]
RewriteCond %{DOCUMENT_ROOT}/frontend/dist/index.html -f
RewriteRule ^ /frontend/dist/index.html [L]
